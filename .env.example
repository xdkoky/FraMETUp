# PostgreSQL connection strings.
# Locally both can be the same. On Supabase + Vercel:
#   DATABASE_URL = Transaction pooler URI (port 6543) + "?pgbouncer=true&connection_limit=1"
#   DIRECT_URL   = Direct connection / session pooler URI (port 5432)
DATABASE_URL="postgresql://director:director@localhost:5432/director_os?schema=public"
DIRECT_URL="postgresql://director:director@localhost:5432/director_os?schema=public"

# Set to "true" behind HTTPS so cookies are marked Secure (automatic on Vercel).
SECURE_COOKIES="false"

# --- AI assistance (optional) ---
# Leave empty to use the local heuristic fallback (no data leaves the server).
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
# Per-user daily limit for AI requests and max input characters per request (cost controls)
AI_DAILY_REQUEST_LIMIT="20"
AI_MAX_INPUT_CHARS="12000"

# --- Uploads ---
# Without Supabase settings, files are stored on local disk in UPLOAD_DIR.
# With them, files go to a PRIVATE Supabase Storage bucket (created automatically).
UPLOAD_DIR="./storage/uploads"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="evidence"
UPLOAD_MAX_BYTES="10485760"

# Email of an existing account that should receive the ADMIN role on seed (optional)
SEED_ADMIN_EMAIL=""
# Create the demo admin account (its password is in the README — never enable on a public site)
SEED_DEMO_ADMIN="true"
