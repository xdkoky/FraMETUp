# PostgreSQL connection string
DATABASE_URL="postgresql://director:director@localhost:5432/director_os?schema=public"

# Used to sign nothing secret client-side; sessions are random tokens hashed in the DB.
# Set to "true" behind HTTPS so cookies are marked Secure.
SECURE_COOKIES="false"

# --- AI assistance (optional) ---
# Leave empty to use the local heuristic fallback (no data leaves the server).
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
# Per-user daily limit for AI requests and max input characters per request (cost controls)
AI_DAILY_REQUEST_LIMIT="20"
AI_MAX_INPUT_CHARS="12000"

# --- Uploads ---
UPLOAD_DIR="./storage/uploads"
UPLOAD_MAX_BYTES="10485760"

# Email of an account that should receive the ADMIN role on seed (optional)
SEED_ADMIN_EMAIL=""
